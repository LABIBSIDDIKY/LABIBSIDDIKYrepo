<% layout = false; %>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0b0d0b">
  <meta name="description" content="Personal portfolio of Saiful Siddiky Labib.">
  <title><%= title %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/animations.css">
  <link rel="stylesheet" href="/css/mindmap.css">
  <link rel="stylesheet" href="/css/hero-video.css">
</head>

<body data-page="home">
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="site-noise" aria-hidden="true"></div>

  <%- include("../partials/navbar", { page, profile }) %>

  <main id="main">

    <!-- HERO SECTION WITH VIDEO BACKGROUND -->
    <section class="hero section-shell">

      <video
        class="hero-video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
        tabindex="-1"
      >
        <source src="/videos/hero-circuit.mp4" type="video/mp4">
      </video>

      <!-- Darkens the video so text stays readable -->
      <div class="hero-video-overlay" aria-hidden="true"></div>

      <!-- Existing animated circuit artwork -->
      <svg
        class="hero-circuit"
        viewBox="0 0 900 620"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
      >
        <path d="M40 100 H230 V180 H370 V100 H510 V220 H690 V120 H860"/>
        <path d="M10 350 H160 V280 H300 V400 H460 V330 H610 V470 H800 V390 H890"/>
        <path d="M100 600 V500 H220 V450 H350 V540 H520 V500 H700 V580 H860"/>
        <circle cx="230" cy="100" r="4"/>
        <circle cx="510" cy="220" r="4"/>
        <circle cx="610" cy="470" r="4"/>
        <circle cx="350" cy="540" r="4"/>
      </svg>

      <div class="hero-topline">
        <span class="eyebrow">
          <span class="status-dot"></span>
          PERSONAL SYSTEM / 001
        </span>
        <span class="mono">
          BANGLADESH · <span data-clock>--:--:--</span>
        </span>
      </div>

      <div class="hero-content">

        <img
          class="profile-picture reveal"
          src="/images/profile.jpg"
          alt="Portrait of Labib"
        />

        <p class="eyebrow reveal">
          HELLO, I'M <%= profile.shortName.toUpperCase() %>
        </p>

        <h1 class="hero-title">
          <span class="title-line">Curious by</span>
          <span class="title-line title-indent">
            nature<span class="accent">.</span>
          </span>
        </h1>

        <p class="hero-copy reveal"><%= profile.intro %></p>

        <div class="hero-actions reveal">
          <a class="button button-primary" href="/projects">
            Explore my work <span>↗</span>
          </a>
          <a class="text-link" href="/about">
            More about me <span>→</span>
          </a>
        </div>
      </div>

      <div class="hero-bottomline">
        <span class="scroll-cue">
          <span class="scroll-wheel"></span>
          SCROLL TO EXPLORE
        </span>
        <span class="mono">BUILD / LEARN / REPEAT</span>
      </div>

    </section>

    <!-- INTRODUCTION -->
    <section class="intro-strip section-shell reveal">
      <p class="eyebrow">A WORK IN PROGRESS</p>
      <p class="intro-statement">
        Learning how things work.<br>
        <span>Building things that matter.</span>
      </p>
      <a class="arrow-link" href="/about">
        Get to know me <span>↗</span>
      </a>
    </section>

    <!-- SKILLS MIND MAP -->
    <section class="section-shell skills-preview section-space">
      <div class="section-heading reveal">
        <div>
          <p class="eyebrow">01 / SKILLS MAP</p>
          <h2>Explore my <span>interests.</span></h2>
        </div>
        <a class="text-link" href="/skills">Full skills explorer ↗</a>
      </div>

      <div class="mindmap-wrap">
        <div class="mindmap-lines" aria-hidden="true"></div>

        <div class="mindmap-center">
          <span class="center-ring"></span>
          <span>LABIB</span>
          <small>TECH STACK / IN PROGRESS</small>
        </div>

        <div class="mindmap-nodes">
          <% skills.forEach((skill) => { %>
            <%- include("../partials/skill-node", { skill }) %>
          <% }) %>
        </div>
      </div>

      <div class="skill-detail" data-skill-detail aria-live="polite">
        <span class="detail-kicker">SELECT A NODE</span>
        <h3>Your next discovery starts here.</h3>
        <p>Choose a branch to see its focus areas and the details to add as you progress.</p>
      </div>
    </section>

    <!-- SELECTED PROJECTS -->
    <section class="section-shell section-space projects-preview">
      <div class="section-heading reveal">
        <div>
          <p class="eyebrow">02 / SELECTED WORK</p>
          <h2>Proof over <span>promises.</span></h2>
        </div>
        <a class="text-link" href="/projects">All projects ↗</a>
      </div>

      <div class="project-grid">
        <% projects.forEach((project) => { %>
          <article class="project-card reveal">
            <div class="project-art">
              <span class="project-number"><%= project.number %></span>
              <div class="art-grid"></div>
              <span class="art-orbit"></span>
              <span class="art-label"><%= project.category.toUpperCase() %></span>
            </div>

            <div class="project-meta">
              <div>
                <p class="eyebrow"><%= project.status %></p>
                <h3><%= project.name %></h3>
              </div>
              <span class="project-arrow">↗</span>
            </div>

            <p class="project-description"><%= project.description %></p>

            <div class="tag-list">
              <% project.stack.forEach(tag => { %>
                <span><%= tag %></span>
              <% }) %>
            </div>
          </article>
        <% }) %>
      </div>
    </section>

    <!-- MINDSET -->
    <section class="section-shell about-callout section-space reveal">
      <p class="eyebrow">03 / THE MINDSET</p>
      <h2>Stay curious.<br>Make it <span>understandable.</span></h2>
      <p>
        Technology gets interesting when you look beyond what it does
        and explore how it works.
      </p>
      <a class="button button-outline" href="/about">
        A little more about me <span>↗</span>
      </a>
    </section>

  </main>

  <%- include("../partials/footer", { profile }) %>

  <script type="application/json" id="skills-data"><%- JSON.stringify(skills).replace(/</g, "\\u003c") %></script>

  <script type="module" src="/js/main.js"></script>
  <script type="module" src="/js/scroll.js"></script>
  <script type="module" src="/js/circuit.js"></script>
  <script type="module" src="/js/clock.js"></script>
  <script type="module" src="/js/mindmap.js?v=4"></script>
</body>
</html>