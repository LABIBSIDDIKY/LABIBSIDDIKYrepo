<% layout = false; %>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0b0d0b">
  <title><%= title %></title>

  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/animations.css">
  <link rel="stylesheet" href="/css/contact-video.css">
  <link rel="stylesheet" href="/css/circuit-hover.css">
</head>

<body data-page="contact">
  <a class="skip-link" href="#main">Skip to content</a>

  <!-- FULL-SCREEN VIDEO BACKGROUND -->
  <div class="contact-video-background" aria-hidden="true">
    <video
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      tabindex="-1"
    >
      <source src="/videos/contact-background.mp4" type="video/mp4">
    </video>
  </div>

  <!-- Darkens the video so text stays readable -->
  <div class="contact-video-overlay" aria-hidden="true"></div>

  <div class="site-noise" aria-hidden="true"></div>

  <%- include("../partials/navbar", { page, profile }) %>

  <main id="main">

    <section class="page-hero section-shell">
      <p class="eyebrow reveal">CONTACT / CONNECT</p>
      <h1 class="page-title reveal">
        Have a good<br>
        <span>problem to solve?</span>
      </h1>
      <p class="page-lead reveal">
        I'm interested in learning, exchanging ideas, and building useful things with thoughtful people.
      </p>
    </section>

    <section class="section-shell content-grid section-space">
      <div>
        <p class="eyebrow">SEND A NOTE</p>
        <h2>Start a <span>conversation.</span></h2>
        <p class="muted">Send me a message and I'll reply by email.</p>
      </div>

      <form class="contact-form" data-contact-form action="https://api.web3forms.com/submit" method="POST">
        <!-- Web3Forms: replace with your access key (it is safe to expose in HTML) -->
        <input type="hidden" name="access_key" value="7b8e4cbd-21f8-4ed5-aeeb-7144f0343921">
        <input type="hidden" name="subject" value="New message from your portfolio">
        <input type="hidden" name="from_name" value="Portfolio contact form">
        <!-- Spam honeypot: real visitors never see or tick this -->
        <input type="checkbox" name="botcheck" class="circuit-ignore" tabindex="-1" autocomplete="off" style="display:none">

        <label for="name">Name</label>
        <input id="name" name="name" required autocomplete="name" placeholder="Your name">

        <label for="email">Email</label>
        <input id="email" name="email" type="email" required autocomplete="email" placeholder="you@example.com">

        <label for="message">Message</label>
        <textarea id="message" name="message" rows="5" required placeholder="What would you like to discuss?"></textarea>

        <button class="button button-primary" type="submit">
          Send message <span>↗</span>
        </button>
        <p class="form-status" data-form-status role="status"></p>
      </form>
    </section>

    <section class="section-shell section-space">
      <p class="eyebrow">ELSEWHERE</p>
      <div class="social-links">
        <% profile.social.forEach(social => { %>
          <a href="<%= social.url %>" target="_blank" rel="noreferrer">
            <%= social.label %> <span>↗</span>
          </a>
        <% }) %>
      </div>
    </section>

  </main>

  <%- include("../partials/footer", { profile }) %>

  <script type="module" src="/js/main.js"></script>
  <script type="module" src="/js/scroll.js"></script>
  <script type="module" src="/js/circuit.js"></script>
  <script type="module" src="/js/clock.js"></script>
  <script type="module" src="/js/circuit-hover.js"></script>
  <script type="module" src="/js/contact-form.js"></script>
</body>
</html>
